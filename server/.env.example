# Copy this file to server/.env (gitignored) and fill it in.
# Never put these values under portal/ — everything there is sent to the browser.

PORT=8080
# 127.0.0.1 = this computer only. Use 0.0.0.0 to open the portal to your network.
HOST=127.0.0.1

# Password that gates uploading to your YouTube channel. Use a long one.
ADMIN_PASSWORD=
# Long random string that signs the admin login cookie. If blank, one is
# generated at startup (you'll just need to log in again after a restart).
AUTH_SECRET=

# OAuth client from Google Cloud Console -> APIs & Services -> Credentials,
# with the YouTube Data API v3 enabled on that project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the channel owner's Google account. It must be granted the
# full https://www.googleapis.com/auth/youtube scope — youtube.upload alone
# can't create or read the category playlists.
YOUTUBE_REFRESH_TOKEN=

# unlisted (default) | public | private
# Note: YouTube forces API uploads to private until your Cloud project passes
# YouTube's API compliance audit, and private videos can't play in the portal.
YOUTUBE_PRIVACY=unlisted
