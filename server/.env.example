# Copy this file to server/.env (gitignored) and fill it in.
# Never put these values under portal/ — everything there is sent to the browser.

PORT=8080
# 127.0.0.1 = this computer only. Use 0.0.0.0 to open the portal to your network.
HOST=127.0.0.1

# Password that gates adding / deleting videos. Use a long one.
ADMIN_PASSWORD=
# Long random string that signs the admin login cookie. If blank, one is
# generated at startup (you'll just need to log in again after a restart).
AUTH_SECRET=

# ---- Video storage: everything in Neon ----
# Database: Neon -> Connect -> Postgres database tab -> pick the database -> Copy snippet
DATABASE_URL=
# Files: Neon -> Connect -> Storage tab. Paste its AWS_* values here as they are.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket the videos go in; `npm run setup` creates it if it doesn't exist.
STORAGE_BUCKET=portal-videos
# Optional: a public URL for the bucket. Blank = it stays private and the
# server hands out signed playback links (recommended).
STORAGE_PUBLIC_URL=
# Addresses the portal is opened from, comma separated (used by `npm run setup`
# for the bucket's CORS rules). Defaults to http://localhost:PORT,http://127.0.0.1:PORT
PORTAL_ORIGINS=
