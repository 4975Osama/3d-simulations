{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/waterSurface.js",
      "destination": "/waterSurface.js"
    },
    {
      "source": "/bg-video.mp4",
      "destination": "/bg video.mp4"
    },
    {
      "source": "/",
      "destination": "/portal/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/portal/:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
