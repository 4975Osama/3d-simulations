# Upload only what the live site needs: the static portal plus the /api
# function and the server code it runs. Secrets (.env), local caches and
# data/ stay off Vercel; its env vars hold the keys instead.
/*
!/portal
!/waterSurface.js
!/bg video.mp4
!/vercel.json
!/api
!/server
!/package.json
!/package-lock.json
/server/node_modules
/server/cache
.env*
